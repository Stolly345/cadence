# Maintainer: Stolly345 <114888417+Stolly345@users.noreply.github.com>
# Repackages the release .deb (same binary as the .deb/.rpm, built on Ubuntu 24.04).
# New release: `make arch` sets pkgver + sha256sums from target/debian/ and rewrites .SRCINFO;
# upload exactly that .deb to the GitHub release, or the checksum won't match.
pkgname=cadence-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Run backups, clean-ups and scripts on a schedule, from ready-made examples (GTK 4)"
arch=('x86_64')
url="https://github.com/Stolly345/cadence"
license=('MIT OR Apache-2.0')
depends=('gtk4' 'libadwaita' 'glib2' 'glibc' 'gcc-libs' 'rsync' 'cronie' 'libnotify' 'polkit' 'hicolor-icon-theme')
optdepends=('curl: ping a Healthchecks.io-style URL after each run'
            'smartmontools: the "Check my drives'"'"' health" example'
            'git: the "Sync my notes with git" example')
provides=('cadence')
conflicts=('cadence')
install=cadence.install
options=('!debug' '!strip')
source=("https://github.com/Stolly345/cadence/releases/download/v${pkgver}/cadence_${pkgver}-1_amd64.deb")
sha256sums=('164713243c6f1b7f029e4e06ba3c73fc1e70fc059d69874de89e5f62ef531c86')

package() {
    bsdtar -xf data.tar.* -C "$pkgdir"
    cd "$pkgdir/usr/share"
    install -Dm644 doc/cadence/LICENSE-MIT "licenses/$pkgname/LICENSE-MIT"
    install -Dm644 doc/cadence/LICENSE-APACHE "licenses/$pkgname/LICENSE-APACHE"
    rm -f doc/cadence/LICENSE-* doc/cadence/copyright
}
